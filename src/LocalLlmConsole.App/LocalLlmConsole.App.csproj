<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>LlamaCppWindowsManager</AssemblyName>
    <RootNamespace>LocalLlmConsole</RootNamespace>
    <AssemblyTitle>llama.cpp Windows Manager</AssemblyTitle>
    <Product>llama.cpp Windows Manager</Product>
    <RepositoryUrl>https://github.com/alekk89/llama-cpp-windows-manager</RepositoryUrl>
    <Version>2.6.0</Version>
    <AssemblyVersion>2.6.0.0</AssemblyVersion>
    <FileVersion>2.6.0.0</FileVersion>
    <InformationalVersion>v2.6.0</InformationalVersion>
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <DebugType Condition="'$(Configuration)' == 'Release'">none</DebugType>
    <DebugSymbols Condition="'$(Configuration)' == 'Release'">false</DebugSymbols>
  </PropertyGroup>
  <ItemGroup>
    <AssemblyMetadata Include="RepositoryCommit" Value="$(RepositoryCommit)" Condition="'$(RepositoryCommit)' != ''" />
    <AssemblyMetadata Include="ReleaseChannel" Value="$(ReleaseChannel)" Condition="'$(ReleaseChannel)' != ''" />
    <AssemblyMetadata Include="ReleaseManifestKey.$(ReleaseManifestKeyId)" Value="$(ReleaseManifestPublicKeySpki)" Condition="'$(ReleaseManifestKeyId)' != '' and '$(ReleaseManifestPublicKeySpki)' != ''" />
    <AssemblyMetadata Include="ReleaseManifestKey.$(ReleaseManifestNextKeyId)" Value="$(ReleaseManifestNextPublicKeySpki)" Condition="'$(ReleaseManifestNextKeyId)' != '' and '$(ReleaseManifestNextPublicKeySpki)' != ''" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.11" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.5" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\LocalLlmConsole.Core\LocalLlmConsole.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="LocalLlmConsole.Tests" />
    <InternalsVisibleTo Include="LocalLlmConsole.UiTests" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="tools\Build-LlamaCppRuntime.ps1" />
    <EmbeddedResource Include="Localization\Strings.en.json" WithCulture="false" />
    <EmbeddedResource Include="Localization\Strings.bg.json" WithCulture="false" />
    <EmbeddedResource Include="Localization\Strings.de.json" WithCulture="false" />
    <EmbeddedResource Include="Localization\Strings.es.json" WithCulture="false" />
    <EmbeddedResource Include="Localization\Strings.fr.json" WithCulture="false" />
    <EmbeddedResource Include="Localization\Strings.ru.json" WithCulture="false" />
    <EmbeddedResource Include="Localization\Strings.ja.json" WithCulture="false" />
    <EmbeddedResource Include="Localization\Strings.pt.json" WithCulture="false" />
    <EmbeddedResource Include="Localization\Strings.zh.json" WithCulture="false" />
    <EmbeddedResource Include="Localization\Strings.it.json" WithCulture="false" />
    <EmbeddedResource Include="Localization\Strings.tr.json" WithCulture="false" />
    <EmbeddedResource Include="Localization\Strings.fa.json" WithCulture="false" />
    <EmbeddedResource Include="Localization\Strings.pl.json" WithCulture="false" />
    <EmbeddedResource Include="Localization\Strings.nl.json" WithCulture="false" />
    <EmbeddedResource Include="Localization\Strings.vi.json" WithCulture="false" />
    <EmbeddedResource Include="Localization\Strings.ko.json" WithCulture="false" />
    <EmbeddedResource Include="Localization\Strings.ar.json" WithCulture="false" />
