<Window x:Class="LocalLlmConsole.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:LocalLlmConsole"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="llama.cpp Windows Manager v2.4.0" MinWidth="900" MinHeight="600" Width="1200" Height="780"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="CanResize"
        Background="{DynamicResource AppBack}"
        Loaded="Window_Loaded" Closing="Window_Closing">
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="0"
                        ResizeBorderThickness="7"
                        GlassFrameThickness="0"
                        CornerRadius="8"
                        UseAeroCaptionButtons="False"/>
  </shell:WindowChrome.WindowChrome>
  <Border Background="{DynamicResource AppBack}"
          CornerRadius="8"
          SnapsToDevicePixels="True">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="48"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>
      <Border Background="{DynamicResource AppBack}"
              BorderBrush="{DynamicResource PanelBorder}"
              BorderThickness="0,0,0,1"
              CornerRadius="8,8,0,0"
              MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
      <Grid Margin="16,0,8,0">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Button x:Name="NavigationToggleButton"
                  Style="{StaticResource TitleBarButton}"
                  Width="28"
                  Height="28"
                  MinHeight="28"
                  Margin="0,0,7,0"
                  Padding="0"
                  AutomationProperties.Name="Collapse navigation menu"
                  shell:WindowChrome.IsHitTestVisibleInChrome="True"
                  Click="NavigationToggleButton_Click">
            <TextBlock Text="&#xE700;"
                       FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                       FontSize="13"
                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>
          </Button>
          <TextBlock Text="llama.cpp Windows Manager"
                     Foreground="{DynamicResource TextMain}"
                     FontSize="13.5"
                     FontWeight="SemiBold"
                     VerticalAlignment="Center"/>
          <Border Margin="9,0,0,0"
                  Padding="6,2"
                  Background="{DynamicResource ControlBack}"
                  CornerRadius="4"
                  VerticalAlignment="Center">
            <TextBlock x:Name="AppVersionText"
                       Text="v2.4.0"
                       Foreground="{DynamicResource TextMuted}"
                       FontSize="10.5"
                       FontWeight="SemiBold"/>
          </Border>
        </StackPanel>
        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    shell:WindowChrome.IsHitTestVisibleInChrome="True">
          <Button x:Name="MinimizeButton" Style="{StaticResource TitleBarButton}" Click="MinimizeButton_Click">
            <Path Data="M 1,7.5 L 11,7.5"
                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                  StrokeThickness="1.25"
                  StrokeStartLineCap="Square"
                  StrokeEndLineCap="Square"/>
          </Button>
          <Button x:Name="MaximizeButton" Style="{StaticResource TitleBarButton}" Click="MaximizeButton_Click">
            <Path Data="M 1.5,1.5 L 10.5,1.5 L 10.5,10.5 L 1.5,10.5 Z"
                  Width="12"
                  Height="12"
                  Stretch="None"
                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                  StrokeThickness="1.2"/>
          </Button>
          <Button x:Name="CloseButton" Style="{StaticResource TitleBarButton}" Tag="Close" Click="CloseButton_Click">
            <Path Data="M 2,2 L 10,10 M 10,2 L 2,10"
                  Width="12"
                  Height="12"
                  Stretch="None"
                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                  StrokeThickness="1.25"
                  StrokeStartLineCap="Square"
                  StrokeEndLineCap="Square"/>
          </Button>
        </StackPanel>
      </Grid>
      </Border>
      <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition x:Name="SidebarColumn" Width="244"/>
        <ColumnDefinition Width="0"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <!-- Sidebar navigation -->
      <Border x:Name="SidebarNavigation"
              Grid.Column="0"
              Style="{StaticResource SidebarShell}">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <!-- Language selector at top -->
          <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <ComboBox x:Name="LanguageCombo"
                      MinHeight="27"
                      Padding="8,2"
                      SelectionChanged="LanguageCombo_SelectionChanged"/>
            <Border Height="1"
                    Background="{DynamicResource PanelBorder}"
                    Margin="0,12,0,0"/>
          </StackPanel>
          <!-- Navigation buttons -->
          <StackPanel Grid.Row="1" VerticalAlignment="Top">
            <Button x:Name="OverviewNavButton" Style="{StaticResource NavButton}" local:VisualRole.NavGlyph="&#xE80F;" Click="ShowOverview_Click"/>
            <Button x:Name="ModelsNavButton" Style="{StaticResource NavButton}" local:VisualRole.NavGlyph="&#xE8B7;" Click="ShowModels_Click"/>
            <Button x:Name="RuntimesNavButton" Style="{StaticResource NavButton}" local:VisualRole.NavGlyph="&#xE943;" Click="ShowRuntimes_Click"/>
            <Button x:Name="SettingsNavButton" Style="{StaticResource NavButton}" local:VisualRole.NavGlyph="&#xE713;" Click="ShowSettings_Click"/>
            <Button x:Name="LifetimeNavButton" Style="{StaticResource NavButton}" local:VisualRole.NavGlyph="&#xE823;" Click="ShowLifetime_Click"/>
            <Button x:Name="LogsNavButton" Style="{StaticResource NavButton}" local:VisualRole.NavGlyph="&#xE8A5;" Click="ShowLogs_Click"/>
            <Border Height="1"
                    Background="{DynamicResource PanelBorder}"
                    Margin="0,8,0,10"/>
            <TextBlock x:Name="ToolsNavLabel"
                       Foreground="{DynamicResource TextMuted}"
                       FontSize="11"
                       FontWeight="SemiBold"
                       Margin="12,0,0,8"/>
            <Button x:Name="WindowsNavButton" Style="{StaticResource NavButton}" local:VisualRole.NavGlyph="&#xE782;" Click="ShowWindows_Click"/>
            <Button x:Name="WslLinuxNavButton" Style="{StaticResource NavButton}" local:VisualRole.NavGlyph="&#xE756;" Click="ShowWslLinux_Click"/>
          </StackPanel>
          <Border Grid.Row="3"
                  Background="{DynamicResource InputBack}"
                  BorderBrush="{DynamicResource PanelBorderStrong}"
                  BorderThickness="1"
                  CornerRadius="8"
                  Padding="11,10"
                  Margin="0,12,0,0">
            <StackPanel>
              <TextBlock x:Name="CurrentStatusLabel"
                         Foreground="{DynamicResource TextMuted}"
                         FontSize="10.5"
                         FontWeight="SemiBold"
                         Margin="0,0,0,4"/>
              <TextBlock x:Name="AppStatusText"
                         Foreground="{DynamicResource TextMain}"
                         FontWeight="SemiBold"
                         AutomationProperties.LiveSetting="Polite"
                         TextWrapping="Wrap"/>
            </StackPanel>
          </Border>
          <StackPanel Grid.Row="2">
            <Button x:Name="UpdatesNavButton" Style="{StaticResource NavButton}" local:VisualRole.NavGlyph="&#xE895;" Click="ShowUpdates_Click"/>
            <Button x:Name="HelpNavButton" Style="{StaticResource NavButton}" local:VisualRole.NavGlyph="&#xE897;" Click="ShowHelp_Click"/>
          </StackPanel>
        </Grid>
      </Border>
      <Grid Grid.Column="2">
      <Grid.RowDefinitions>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>
      <Border Style="{StaticResource WorkspaceShell}">
        <ContentControl x:Name="PageHost"/>
      </Border>
      </Grid>
      </Grid>
    </Grid>
  </Border>
</Window>
